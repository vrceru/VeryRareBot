# Required
DISCORD_TOKEN=

# Optional: set this while developing to sync slash commands to one server quickly.
GUILD_ID=

# Discord channels
ANNOUNCEMENT_CHANNEL_ID=
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
VRMS_CHANNEL_ID=

# Discord roles (leave unset for roles that do not exist)
OWNER_ROLE_ID=
DEV_OPS_ROLE_ID=
ADMIN_ROLE_ID=
STAFF_ROLE_ID=
VRS_MEMBER_ROLE_ID=

# Jellyfin
JELLYFIN_URL=http://localhost:8096
JELLYFIN_TOKEN=
JELLYFIN_USER_ID=

# VRMS: path inspection is always safe. Service controls require a valid systemd unit.
VRMS_PATH=/home/ceru/VRMS
VRMS_SERVICE_NAME=

# Logging
LOG_LEVEL=INFO
