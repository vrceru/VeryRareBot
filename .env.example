# Required
DISCORD_TOKEN=

# Optional: set this while developing to sync slash commands to one server quickly.
GUILD_ID=

# Discord channels
ANNOUNCEMENT_CHANNEL_ID=
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
VRMS_CHANNEL_ID=

# Discord roles (leave unset for roles that do not exist)
OWNER_ROLE_ID=
DEV_OPS_ROLE_ID=
ADMIN_ROLE_ID=
STAFF_ROLE_ID=
VRS_MEMBER_ROLE_ID=

# Jellyfin
JELLYFIN_URL=http://localhost:8096
JELLYFIN_TOKEN=
JELLYFIN_USER_ID=

# VRMS: path inspection is always safe. Service controls require a valid systemd unit.
VRMS_PATH=/home/ceru/VRMS
VRMS_SERVICE_NAME=

# Music playback
MUSIC_MAX_QUEUE_SIZE=200
MUSIC_DEFAULT_VOLUME=0.5
MUSIC_IDLE_DISCONNECT_SECONDS=300
MUSIC_SEARCH_RESULTS=5
FFMPEG_PATH=ffmpeg

# Notifications: leave channel IDs blank to disable polling.
JELLYFIN_NOTIFY_CHANNEL_ID=
JELLYFIN_POLL_SECONDS=300
VRMS_NOTIFY_CHANNEL_ID=
VRMS_POLL_SECONDS=60

# Support tickets
TICKET_CATEGORY_ID=
TICKET_STAFF_ROLE_ID=
TICKET_MAX_OPEN_PER_USER=3

# Media requests: get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
MEDIA_REQUEST_CHANNEL_ID=
MEDIA_QUE_CHANNEL_ID=

# VRMS API (the media download/organize pipeline itself -- separate from VRMS_SERVICE_NAME's
# systemd control above). Leave VRMS_API_URL blank to keep media requests staff-managed by hand.
VRMS_API_URL=
VRMS_API_KEY=
VRMS_JOB_POLL_SECONDS=30

# SQLite database for warnings and saved playlists.
DATABASE_PATH=

# Logging
LOG_LEVEL=INFO
